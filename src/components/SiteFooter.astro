---
/** Bottom of every page: the accounts, and when the stream is on. */
import { socials } from "../data/channel";

interface Props {
  /** "full": logo and every account (home); "compact": one row (clips page). */
  variant?: "full" | "compact";
  streamTime: string;
}
const { variant = "full", streamTime } = Astro.props;
const shown = variant === "full" ? socials : socials.filter((s) => s.label === "Kick" || s.label === "YouTube");
---

<footer class:list={["foot", variant]}>
  <div class="container inner">
    {variant === "full" && <img src="/img/logo.png" alt="KAELITH" width="200" class="logo" />}
    <nav aria-label="Hesaplar">
      {
        shown.map((s) => (
          <a href={s.href} class:list={["btn btn--pill", { "btn--neon": s.primary }]}>
            {s.label}
          </a>
        ))
      }
    </nav>
    <p>Her gece {streamTime} canlı · Türkçe CS2</p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
  }
  .inner {
    padding-block: 48px 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }
  .compact .inner {
    padding-block: 32px;
    flex-direction: row-reverse;
    flex-wrap: wrap;
    justify-content: space-between;
    text-align: left;
  }
  .logo {
    height: auto;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .btn--neon {
    color: var(--neon);
  }
  p {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
</style>
