---
/**
 * Top bar of every page: logo home, optional section links, and whatever the
 * page puts on the right (`slot="action"`). With section links, a phone gets a
 * Menü button instead: the links drop down under the bar as a popover
 * (scripts/menu.ts), the way Claude Design drew it.
 */
import Icon from "./Icon.astro";

interface Link {
  href: string;
  label: string;
}
interface Props {
  nav?: Link[];
  sticky?: boolean;
  /** Last row of the phone menu, a page of its own (shown in neon). */
  menuLink?: Link;
  /** One quiet line under the phone menu. */
  menuNote?: string;
}
const { nav = [], sticky = false, menuLink, menuNote } = Astro.props;
const hasMenu = nav.length > 0;
---

<header class:list={["head", { sticky }]}>
  <div class="container bar">
    <a href="/" class="logo" aria-label="kaelithcs.com ana sayfa">
      <img src="/img/k.png" alt="" width="40" height="40" />
      <img src="/img/yazi.png" alt="KAELITH" class="word" height="18" />
    </a>
    {
      hasMenu && (
        <nav class="sections" aria-label="Bölümler">
          {nav.map((n) => (
            <a href={n.href}>{n.label}</a>
          ))}
        </nav>
      )
    }
    <slot name="action" />
    {
      hasMenu && (
        <button class="menu-btn" type="button" popovertarget="site-menu" aria-controls="site-menu" aria-expanded="false" aria-label="Menü" data-menu-btn>
          <span class="icon-closed">
            <Icon name="menu" />
          </span>
          <span class="icon-open">
            <Icon name="close" />
          </span>
        </button>
      )
    }
  </div>
  {
    hasMenu && (
      <nav id="site-menu" class="menu" popover aria-label="Bölümler" data-menu>
        <ul>
          {nav.map((n) => (
            <li>
              <a href={n.href}>{n.label}</a>
            </li>
          ))}
          {menuLink && (
            <li>
              <a href={menuLink.href} class="menu-page">
                {menuLink.label}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          )}
        </ul>
        {menuNote && <p>{menuNote}</p>}
      </nav>
    )
  }
</header>

{
  hasMenu && (
    <script>
      import { wireMenu } from "../scripts/menu";
      wireMenu();
    </script>
  )
}

<style>
  .head {
    border-bottom: 1px solid var(--line);
    background: rgba(6, 8, 7, 0.96);
  }
  .sticky {
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bar {
    padding-block: 8px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch);
  }
  .logo img {
    object-fit: contain;
  }
  .word {
    width: auto;
  }
  .sections {
    display: flex;
    gap: 22px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .sections a {
    color: var(--muted);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  .sections a:hover {
    color: var(--text);
  }

  .menu-btn {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: var(--touch);
    height: var(--touch);
    padding: 0;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .menu-btn:hover {
    border-color: var(--neon);
    color: var(--neon);
  }
  .menu-btn span {
    display: flex;
  }
  .menu-btn[aria-expanded="true"] .icon-closed,
  .menu-btn:not([aria-expanded="true"]) .icon-open {
    display: none;
  }

  /* The phone menu. Never set `display` here: the popover's own open/closed
     rule decides it. Its top is the bar's bottom, set when it opens. */
  .menu {
    position: fixed;
    inset: var(--menu-top, 61px) 0 auto 0;
    width: auto;
    height: auto;
    max-height: calc(100dvh - var(--menu-top, 61px));
    margin: 0;
    overflow-y: auto;
    padding: 8px 16px 20px;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    background: var(--bg-1);
    color: var(--text);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.5);
  }
  .menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
  }
  .menu li {
    border-bottom: 1px solid var(--line);
  }
  .menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    color: var(--text);
    font-size: 17px;
    font-weight: 600;
  }
  .menu a:hover,
  .menu .menu-page {
    color: var(--neon);
  }
  .menu p {
    margin: 16px 0 0;
    font-size: 14px;
    color: var(--muted);
  }

  /* Phone: no section row in the bar; logo, the page's button, Menü */
  @media (max-width: 820px) {
    .sections {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    /* One row whatever the width: the wordmark gives way first */
    .bar {
      flex-wrap: nowrap;
    }
    .logo {
      flex: 0 1 auto;
      min-width: 0;
      margin-right: auto;
    }
    .logo img:first-child {
      flex: 0 0 auto;
    }
    .word {
      flex: 0 1 auto;
      min-width: 0;
      width: 164px;
      height: auto;
    }
  }
  @media (min-width: 821px) {
    .menu {
      display: none;
    }
  }
</style>

<style is:global>
  /* The page dims behind the open phone menu; the bar stays lit. Two rules:
     a browser without :popover-open would drop the whole list. */
  body:has(#site-menu:popover-open) :is(main, footer) {
    filter: brightness(0.35);
  }
  body:has(#site-menu.is-open) :is(main, footer) {
    filter: brightness(0.35);
  }
</style>
