---
/**
 * Top bar of every page: logo home, optional section links, and whatever the
 * page puts on the right (`slot="action"`). Sticky on wide screens only, so
 * on a phone it does not eat the screen.
 */
interface Props {
  nav?: { href: string; label: string }[];
  sticky?: boolean;
}
const { nav = [], sticky = false } = Astro.props;
---

<header class:list={["head", { sticky }]}>
  <div class="container bar">
    <a href="/" class="logo" aria-label="kaelithcs.com ana sayfa">
      <img src="/img/k.png" alt="" width="40" height="40" />
      <img src="/img/yazi.png" alt="KAELITH" class="word" height="18" />
    </a>
    {
      nav.length > 0 && (
        <nav aria-label="Bölümler">
          {nav.map((n) => (
            <a href={n.href}>{n.label}</a>
          ))}
        </nav>
      )
    }
    <slot name="action" />
  </div>
</header>

<style>
  .head {
    border-bottom: 1px solid var(--line);
    background: rgba(6, 8, 7, 0.94);
  }
  .sticky {
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bar {
    padding-block: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--touch);
  }
  .logo img {
    object-fit: contain;
  }
  .word {
    width: auto;
  }
  nav {
    display: flex;
    gap: 22px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav a {
    color: var(--muted);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  nav a:hover {
    color: var(--text);
  }
  /* Phone: the section links get their own swipeable row under the logo */
  @media (max-width: 820px) {
    .sticky {
      position: relative;
    }
    nav {
      order: 3;
      flex: 1 1 100%;
      gap: 18px;
      font-size: 14px;
    }
  }
</style>
