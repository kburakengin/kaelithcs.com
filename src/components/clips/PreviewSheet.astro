---
/**
 * The preview: a bottom sheet on a phone, a centred dialog on a wide screen.
 * Plays only the cut that plays on stream (YouTube's own start/end); filled
 * by scripts/clips-page.ts from the card that opened it.
 */
import Icon from "../Icon.astro";
---

<dialog class="sheet" aria-labelledby="sheet-title" data-sheet>
  <span class="grip" aria-hidden="true"></span>
  <div class="top">
    <h2 id="sheet-title" data-sheet-title></h2>
    <button type="button" class="btn icon" data-sheet-close aria-label="Kapat"><Icon name="close" size={18} /></button>
  </div>

  <div class="player" data-player>
    <img src="" alt="" data-sheet-img />
    <button type="button" class="start" data-play aria-label="Önizlemeyi oynat">
      <span aria-hidden="true"><Icon name="play" size={28} /></span>
    </button>
  </div>
  <div class="playing" data-playing hidden>
    <div class="playing-row">
      <span class="on"><span class="pulse" aria-hidden="true"></span>OYNATILIYOR</span>
      <button type="button" class="btn" data-stop>Durdur</button>
    </div>
    <span class="bar" aria-hidden="true"><span data-progress></span></span>
  </div>

  <div class="meta">
    <span data-sheet-range></span>
    <span data-sheet-pos></span>
  </div>

  <button type="button" class="copy" data-sheet-copy>
    <span class="mono" data-sheet-cmd></span>
    <span class="copy-word"><Icon name="copy" size={18} />Kopyala</span>
  </button>

  <div class="nav">
    <button type="button" class="btn" data-prev><Icon name="prev" size={16} />Önceki</button>
    <button type="button" class="btn" data-next>Sonraki<Icon name="next" size={16} /></button>
  </div>
</dialog>

<style>
  .sheet {
    width: 100%;
    max-width: 560px;
    max-height: 92vh;
    margin: auto auto 0;
    padding: 10px 16px 20px;
    border: 1px solid var(--line-strong);
    border-radius: 20px 20px 0 0;
    background: var(--bg-1);
    color: var(--text);
    flex-direction: column;
    gap: 14px;
  }
  .sheet[open] {
    display: flex;
  }
  .sheet::backdrop {
    background: rgba(0, 0, 0, 0.72);
  }
  @media (min-width: 720px) {
    .sheet {
      margin: auto;
      border-radius: var(--radius-lg);
    }
  }
  .grip {
    align-self: center;
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: var(--line-strong);
  }
  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  h2 {
    margin: 6px 0 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
  }
  .icon {
    flex: 0 0 auto;
    width: var(--touch);
    padding: 0;
  }
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }
  .player img,
  .player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .start {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    padding: 0;
    background: rgba(6, 8, 7, 0.35);
    cursor: pointer;
  }
  .start span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--neon);
    color: var(--bg-0);
  }
  /* Under the player, not over it: YouTube's own controls stay reachable */
  .playing {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .playing-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .on {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--neon);
  }
  .on span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--neon);
  }
  .bar {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: rgba(242, 245, 242, 0.2);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--neon);
    animation: fill linear forwards;
  }
  @keyframes fill {
    to {
      width: 100%;
    }
  }
  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
    color: var(--muted);
  }
  .copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 56px;
    padding: 0 18px;
    border-radius: var(--radius-md);
    border: 0;
    background: var(--neon);
    color: var(--bg-0);
    cursor: pointer;
  }
  .copy .mono {
    font-size: 17px;
    font-weight: 700;
  }
  .copy-word {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
  }
  .nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
</style>
