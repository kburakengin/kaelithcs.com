---
import SectionHeading from "../SectionHeading.astro";
import { gear } from "../../data/channel";
---

<section id="ekipman" class="section">
  <div class="container stack">
    <SectionHeading eyebrow="MASAMDA" title="Ekipman" />
    <dl class="grid">
      {
        gear.map(([what, model]) => (
          <div class="item">
            <dt>{what}</dt>
            <dd>{model}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  /* One-pixel gaps on the line colour draw the grid lines */
  .grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px 24px;
    background: var(--bg-0);
  }
  dt {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }
</style>
